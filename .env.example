# Supabase (authentication)
#
# Copy to `.env.local` and fill in from your Supabase project:
#   Project Settings → API → Project URL / anon (publishable) key
#
# Both values are client-safe: the anon key can only do what Row Level
# Security allows. NEVER put the service-role key in a NEXT_PUBLIC_ variable.
#
# Leave unset to run in local prototype mode (local accounts + demo user).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
